{
  "name": "Vitamin-C · Inbound email to Brain",
  "nodes": [
    {
      "id": "gmail-message-received",
      "name": "Gmail message received",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [
        -720,
        -120
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": true,
        "filters": {
          "readStatus": "both",
          "includeSpamTrash": false,
          "includeDrafts": false,
          "q": "-in:sent -in:drafts -in:spam -in:trash -label:vitamin-c-brain-indexed"
        },
        "options": {}
      }
    },
    {
      "id": "daily-recovery-scan",
      "name": "Daily recovery scan",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -720,
        120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "load-gmail-labels",
      "name": "Load Gmail labels",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -480,
        0
      ],
      "parameters": {
        "resource": "label",
        "operation": "getAll",
        "returnAll": true
      }
    },
    {
      "id": "processing-label",
      "name": "Processing label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "jsCode": "const index = $input.all().findIndex(item => item.json.name === 'vitamin-c-brain-indexed'); if (index < 0) throw new Error('Create the Gmail label vitamin-c-brain-indexed before activating this workflow.'); return [{ json: { labelId: $input.all()[index].json.id }, pairedItem: { item: index } }];"
      }
    },
    {
      "id": "unindexed-inbound-email",
      "name": "Unindexed inbound email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "simple": false,
        "filters": {
          "readStatus": "both",
          "includeSpamTrash": false,
          "q": "after:1790784720 -in:sent -in:drafts -in:spam -in:trash -label:vitamin-c-brain-indexed"
        },
        "options": {
          "downloadAttachments": false
        }
      }
    },
    {
      "id": "prepare-email",
      "name": "Prepare email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "function normalizeEmail(mail) {\n  if (!mail || !/^[a-f0-9]+$/i.test(mail.id || '')) throw new Error('Missing Gmail message ID.');\n  if (mail.labelIds?.some(label => ['SENT', 'DRAFT', 'SPAM', 'TRASH'].includes(label))) return null;\n  const address = value => typeof value === 'string' ? value : value?.text || value?.value?.map(v => v.address).join(', ') || '';\n  const body = typeof mail.text === 'string' ? mail.text.trim() : '';\n  // Gmail's MIME parser produces text for HTML mail. Never substitute the truncated snippet.\n  if (!body) throw new Error('No full email text was returned; inspect the Gmail MIME output.');\n  const date = new Date(mail.date);\n  const receivedAt = Number.isNaN(date.getTime()) ? '' : date.toISOString();\n  const subject = String(mail.subject || '(No subject)');\n  const from = address(mail.from), to = address(mail.to);\n  const threadId = String(mail.threadId || mail.id);\n  const sourceUrl = `https://mail.google.com/mail/u/?authuser=luke%40vitaminc.vc#all/${threadId}`;\n  return {\n    content: `Email subject: ${subject}\\nFrom: ${from}\\nTo: ${to}\\nDate: ${receivedAt || 'Unknown'}\\nMailbox: luke@vitaminc.vc\\n\\n${body}`,\n    customId: `vitaminc_luke_gmail_${mail.id}`,\n    containerTag: 'vitaminc_email_admin',\n    taskType: 'superrag',\n    metadata: { sourceType: 'email', provider: 'Gmail', mailbox: 'luke@vitaminc.vc', gmailMessageId: mail.id, gmailThreadId: threadId, subject, from, to, receivedAt, sourceUrl, visibility: 'admin', ingestionVersion: 1 },\n  };\n}\nreturn $input.all().flatMap((item, index) => { const json = normalizeEmail(item.json); return json ? [{ json, pairedItem: { item: index } }] : []; });"
      }
    },
    {
      "id": "ingest-email",
      "name": "Ingest email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 30000
        },
        "method": "POST",
        "url": "https://api.supermemory.ai/v3/documents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "wait-for-indexing",
      "name": "Wait for indexing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "webhookId": "vitaminc-email-indexing"
    },
    {
      "id": "check-document-status",
      "name": "Check document status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 30000
        },
        "url": "={{ 'https://api.supermemory.ai/v3/documents/' + encodeURIComponent($('Ingest email').item.json.id) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "validate-indexing",
      "name": "Validate indexing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.status === 'failed') throw new Error('Supermemory indexing failed for document ' + $json.id);\nif ($json.status !== 'done' && $runIndex >= 19) throw new Error('Indexing did not complete after 5 minutes; retry this saved execution.');\nreturn { json: { ...$json, pollAttempt: $runIndex + 1 } };"
      }
    },
    {
      "id": "ready-for-the-brain",
      "name": "Ready for the Brain",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "document-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ingestion-receipt",
      "name": "Ingestion receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        -80
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { documentId: $json.id, customId: $json.customId, status: $json.status, gmailMessageId: $json.metadata?.gmailMessageId, sourceUrl: $json.metadata?.sourceUrl, mailbox: $json.metadata?.mailbox, indexedAt: new Date().toISOString() } };"
      }
    },
    {
      "id": "mark-indexed-in-gmail",
      "name": "Mark indexed in Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1920,
        -80
      ],
      "parameters": {
        "resource": "message",
        "operation": "addLabels",
        "messageId": "={{ $json.gmailMessageId }}",
        "labelIds": "={{ [$('Processing label').first().json.labelId] }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "email-knowledge",
      "name": "Email knowledge",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        220,
        -280
      ],
      "parameters": {
        "content": "## Vitamin-C email → Brain\nGmail Message Received wakes the pipeline only when new matching mail is found. A daily recovery scan catches failed messages and older mail moved out of spam. Each run loads up to 50 unindexed messages since pilot activation. Full text, no attachments.\nAdmin-only container: `vitaminc_email_admin`. Stable Gmail IDs make retries idempotent.\nMarks vitamin-c-brain-indexed only after indexing completes. Does not mark mail read. Screening enforcement remains off.\nCredentials: existing Gmail OAuth + one shared scoped Supermemory Bearer key.",
        "width": 680,
        "height": 260
      }
    }
  ],
  "connections": {
    "Gmail message received": {
      "main": [
        [
          {
            "node": "Load Gmail labels",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily recovery scan": {
      "main": [
        [
          {
            "node": "Load Gmail labels",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Gmail labels": {
      "main": [
        [
          {
            "node": "Processing label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Processing label": {
      "main": [
        [
          {
            "node": "Unindexed inbound email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unindexed inbound email": {
      "main": [
        [
          {
            "node": "Prepare email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare email": {
      "main": [
        [
          {
            "node": "Ingest email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingest email": {
      "main": [
        [
          {
            "node": "Wait for indexing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for indexing": {
      "main": [
        [
          {
            "node": "Check document status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check document status": {
      "main": [
        [
          {
            "node": "Validate indexing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate indexing": {
      "main": [
        [
          {
            "node": "Ready for the Brain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingestion receipt": {
      "main": [
        [
          {
            "node": "Mark indexed in Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ready for the Brain": {
      "main": [
        [
          {
            "node": "Ingestion receipt",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for indexing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "executionTimeout": 600
  },
  "pinData": {}
}
