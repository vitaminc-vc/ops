# Vitamin°C Supabase, Frankfurt. Server-only variables; never add a VITE_ prefix.
SUPABASE_PROJECT_REF=euaxzitprzcazefjfjuu
DATABASE_HOST=aws-0-eu-central-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_USER=vitamin_c_app.euaxzitprzcazefjfjuu
DATABASE_NAME=postgres
SUPABASE_DB_PASSWORD=
# Alternatively set DATABASE_URL. Use a separately privileged URL for migrations.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Optional certificate from the Supabase dashboard, if not trusted by the system.
DATABASE_SSL_CA_PATH=./certs/supabase-prod-ca-2021.crt
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Optional, server-side default for the one-time first-admin bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=

# One server-side Supermemory key restricted to vitaminc_email_admin.
# Ingestion and retrieval use this same key. Google mailbox authorization is separate.
SUPERMEMORY_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=gpt-6-luna

# Read-only token restricted to the Vitamin-C portfolio base.
AIRTABLE_API_KEY=
# Separate encryption key for local connector/settings storage (32 random bytes, hex).
CONNECTOR_ENCRYPTION_KEY=
# Persistent directory is required in production; use one server instance with file storage.
INTEGRATION_STATE_DIRECTORY=
# Owner-created Notion integration: Read, Insert and Update content on the approved deal database.
NOTION_API_KEY=

# Better Auth Google web client. Never expose its secret to the browser.
# Callback: https://<app-host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable only after the connected-mailbox sync workflow has been configured.
GMAIL_SYNC_ENABLED=false
# Separate service credential in n8n; it cannot access app admin APIs.
INGESTION_API_KEY=
NOTION_DEAL_DATABASE_ID=
# Optional when the database has multiple data sources.
NOTION_DEAL_DATA_SOURCE_ID=
AIRTABLE_BASE_ID=appiNFlTS3OLfTkxB
